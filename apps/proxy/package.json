{
  "name": "zhiliaowo-proxy",
  "version": "3.0.1",
  "description": "知了窝开放平台 BFF 代理服务与 6 板块海报数据接口（Hono + SQLite + 缓存抽象）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "sync": "tsx src/scripts/sync.ts",
    "sync:current": "tsx src/scripts/sync-current.ts",
    "recompute": "tsx src/scripts/recompute-agg.ts"
  },
  "keywords": [
    "zhiliaowo",
    "sci",
    "proxy",
    "bff",
    "hono"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "catalog:",
    "better-sqlite3": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "mysql2": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
