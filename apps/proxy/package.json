{
  "name": "zhiliaowo-proxy",
  "version": "0.1.0",
  "description": "知了窝开放平台 BFF 代理服务 + H5 生成器服务端模块（Hono + SQLite + 缓存抽象 + Puppeteer 导出）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "zhiliaowo",
    "sci",
    "proxy",
    "bff",
    "hono",
    "h5"
  ],
  "license": "MIT",
  "dependencies": {
    "@zhiliaowo/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "ioredis": "^6.0.0",
    "puppeteer": "^23.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:"
  }
}
