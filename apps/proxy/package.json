{
  "name": "zhiliaowo-proxy",
  "version": "1.1.1",
  "description": "知了窝开放平台 BFF 代理服务 + H5 生成器服务端模块（Hono + SQLite + 缓存抽象 + Puppeteer 导出）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "sync": "tsx scripts/sync.ts",
    "sync:current": "tsx scripts/sync-current.ts",
    "recompute": "tsx scripts/recompute-agg.ts"
  },
  "keywords": [
    "zhiliaowo",
    "sci",
    "proxy",
    "bff",
    "hono",
    "h5"
  ],
  "license": "MIT",
  "dependencies": {
    "@zhiliaowo/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.4",
    "ioredis": "^6.0.0",
    "puppeteer": "^25.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:"
  }
}
