# 知了窝开放平台 —— 代理服务环境变量示例
# 复制为 .env 后填值（.env 已被 .gitignore 忽略，不会入库）
# 单一事实源：所有 app（proxy / admin）共用此根 .env

# ---- 知了窝开放平台鉴权（仅服务端读取，绝不落前端）----
ZLIW_ELAB_APPID=your_elab_appid
ZLIW_PROCELL_APPID=your_procell_appid
# 开放 API 基址（默认 v12，切换版本改此处）
ZLIW_API_BASE=https://open.zhiliaowo.cn/openapi/v12
# 开放组件（iframe）基址（默认 v11）
ZLIW_WIDGET_BASE=https://open.zhiliaowo.cn/v_widget/v11

# ---- 缓存 ----
# memory（默认，零依赖）| redis
CACHE_DRIVER=memory
# 仅 CACHE_DRIVER=redis 时需要
# CACHE_REDIS_URL=redis://127.0.0.1:6379

# ---- 服务监听端口（统一管理，改此处即可换端口）----
# 后端 proxy（Hono）端口
PORT=3000
# HOST=127.0.0.1

# ---- 前端 dev 端口（Vite，统一管理）----
# 管理后台（admin）dev 端口
DEV_PORT_ADMIN=5173
# admin 反向代理目标端口（即后端 proxy 端口，需与 PORT 一致）
DEV_PORT_PROXY=3000

# ---- 前端联调（Vite dev，注入 import.meta.env）----
# 后台 / 展示页默认 http://localhost:3000；如代理部署在别的地址可覆盖
# VITE_API_BASE=http://localhost:3000

# 【自由】OpenAI 兼容 API 配置（⚠️ 请勿提交真实 API Key 到此文件）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://apihub.agnes-ai.com/v1
# AI_MODEL=agnes-2.5-pro
AI_MODEL=agnes-2.5-flash
# 单次 AI 调用超时（毫秒）
AI_TIMEOUT_MS=60000
# 板块 4 本地零命中文献是否启用 AI 兜底（0=关，1=开，默认关，推荐本地匹配为主）
AI_HOTSPOT_FALLBACK=0

# ---- 报告数据（6 板块海报）----

# 热点关键词：源 Excel 与生成 JSON 的目录/命名约定
# 源：data/hotspot-keywords/<brandKey>.xlsx（每品牌一份，文件名即 brandKey，小写；如 procell.xlsx）
#   - 仅读 Sheet1：A 列=中文热点名(cn)，B 列=英文关键词(逗号分隔)；第 1 行为表头需跳过
#   - 由 scripts/gen-hotspot-keywords.mjs 解析生成下方 JSON
# 产物：HOTSPOT_DIR 下的 <brandKey>.json（结构 { brandKey, generatedAt, items:[{cn,keywords:[]}] }）
#   - 板块 4 本地关键词匹配：对 title 做词边界正则匹配 keywords，统计 Top10
# 英文站点：可选 <brandKey>.en.json（items 额外带 zh 字段=中文标签，用于中文聚合键→英文展示名映射）
#   - 缺失则英文站复用中文版（关键词/展示名均为中文）
HOTSPOT_DIR=apps/proxy/config/hotspots

# 重点期刊 JSON 目录（板块 1「研究概述」用）
#   文件命名 <brandKey>.json（如 procell.json），结构 { "featured": ["Cell","Nature",...] }
#   对 journal 字段忽略大小写精确匹配 featured 名单统计篇数
JOURNALS_DIR=apps/proxy/config/journals

# 提示词模板目录（板块 6 结论 / 板块 4 AI 兜底 用）
#   文件命名 <brandKey>-<name>.md（如 procell-conclusion.md）；缺失则该功能回退内置默认提示词
#   英文站点：可选 <brandKey>.en-<name>.md（如 procell.en-conclusion.md），缺失回退中文版
#   可用 name（按品牌各一份）：
#     conclusion        板块 6 小结文案生成（conclusion.ts）
#     hotspot-fallback  板块 4 本地零命中时 AI 兜底打标（sync.ts，仅 AI_HOTSPOT_FALLBACK=1 生效）
#     org-translate     预留：板块 6「通讯作者单位译中文校名」，因 corOrg 字段为空暂未启用
AI_PROMPT_DIR=apps/proxy/config/prompts

# 同步分页参数
# 请求时「期望」的每页条数。注意：上游 2.6 接口对 pageSize 有硬上限且静默钳制
# （2026-09-02 实测上限 15：传 16/100/1000 一律回退为 15，响应回显 pageSize=15、
# totalPage=ceil(totalCount/15)）。同步逻辑已改为以回显值为准自适应，此值调大既不会报错
# 也不会加速，但上游若放宽上限可自动受益，故保持较大值即可。
REPORT_PAGE_SIZE=1000
# 并发拉取页数。
# 本同步是网络 I/O 密集型（单页 300~800ms 几乎全在等上游，解析+落库 <1ms），
# CPU 核心数不是瓶颈，并发可以远超核心数；真正的天花板是上游限流。
# 留空 / 0 / auto → 自动推导：CPU 核心数 × 2，钳制到 [4, 12]。
#   （本开发机 16 核 → 推导 32 → 截到 12。）
# 正整数则直接使用。建议 8~12；若发现失败页明显增多，说明上游开始限流，请下调。
REPORT_SYNC_CONCURRENCY=8
# 板块 4 本地零命中 AI 兜底上限：超出该篇数的零命中文献不再送 AI 打标（默认 200）
AI_HOTSPOT_FALLBACK_CAP=200

# ---- 四站点生产库（只读，板块 5 产品中文名/分类用）----
# ⚠️ 仅只读：本服务只发 SELECT，绝不执行任何写入/DDL/DML（防误改生产数据）。
# ⚠️ 表名/列名已按生产库 information_schema 实测确认（2026-09-08）：
#    主表 = <dbPrefix>product_main（procellcn_product_main / pricella_product_main / elabcn_product_main / elabcom_product_main）
#    主键 catid（与接口 goodsSpu 对应）
#    产品名称 = 主表 title_c（中文站 procellcn/elabcn）/ title（英文站 pricella/elabcom），按站点 locale 自动取
#    产品分类 = 主表 sort_i（一级分类 ID）→ LEFT JOIN <dbPrefix>goodstype_web ON goodstypeid=sort_i，
#              按站点 locale 取 name_cn(中文站)/name_en(英文站)，即一级分类文字
#    接口字段：productName（产品名称）、productCategory（一级分类名，已转文字）
# 不启用（默认）时板块 5 仅返回 goodsSpu + goodsLabel，前端自行补中文名/分类，不影响其他接口。
#
# ★ 各站点账号/密码/库名不同 —— 凭据**按站点解析**，优先级：站点级 > 品牌级 > 全局默认
#   字段后缀：_ENABLED / _HOST / _PORT / _USER / _PASSWORD / _DATABASE
#   站点级  ：PROD_MYSQL_<SITEKEY>_<字段>   （SITEKEY = ELABCN / ELABCOM / PROCELLCN / PRICELLA）
#   品牌级  ：PROD_MYSQL_<BRANDKEY>_<字段>  （BRANDKEY = ELABSCIENCE / PROCELL，同品牌两站点共用一份）
#   全局默认：PROD_MYSQL_<字段>             （兜底）
#   例：Procell 中文站专属 → PROD_MYSQL_PROCELLCN_USER；Procell 品牌两站共用 → PROD_MYSQL_PROCELL_USER
#
# 推荐做法：两大品牌各配一组品牌级凭据（<BRANDKEY> 段），站点级仅在有差异时覆盖。
# 注意：ENABLED 同样按上述优先级解析，未配则默认关闭（该站点板块 5 仅返回 goodsLabel）。

# —— 品牌级（推荐：两大品牌各一份，同品牌中英文站共用）——
# PROD_MYSQL_ELABSCIENCE_ENABLED=1
# PROD_MYSQL_ELABSCIENCE_HOST=10.30.30.130
# PROD_MYSQL_ELABSCIENCE_PORT=3307
# PROD_MYSQL_ELABSCIENCE_USER=elabscience
# PROD_MYSQL_ELABSCIENCE_PASSWORD=
# PROD_MYSQL_ELABSCIENCE_DATABASE=elabscience

# PROD_MYSQL_PROCELL_ENABLED=1
# PROD_MYSQL_PROCELL_HOST=10.30.30.130
# PROD_MYSQL_PROCELL_PORT=3307
# PROD_MYSQL_PROCELL_USER=procell
# PROD_MYSQL_PROCELL_PASSWORD=
# PROD_MYSQL_PROCELL_DATABASE=procell

# —— 站点级覆盖（仅当某站点账号/库名与品牌级不同时才需要，示例）——
# PROD_MYSQL_PROCELLCN_USER=procell_cn_ro           # Elabscience 中文站独立账号
# PROD_MYSQL_PROCELLCN_DATABASE=procell_cn          # 中文站独立库
# PROD_MYSQL_PRICELLA_PASSWORD=different_pass        # Procell Global 独立密码

# —— 全局默认（兜底，仅在所有站点/品牌级都未配时使用）——
# PROD_MYSQL_ENABLED=1
# PROD_MYSQL_HOST=10.30.30.130
# PROD_MYSQL_PORT=3307
# PROD_MYSQL_USER=
# PROD_MYSQL_PASSWORD=
# PROD_MYSQL_DATABASE=

# ---- 管理接口鉴权（POST /report/refresh 触发同步）----
# 配置后调用 refresh 必须携带 x-admin-token（或 Authorization: Bearer）头；不配置则放行（dev 便利）
# ADMIN_TOKEN=change-me-to-a-strong-random-token

# ---- CORS 跨域白名单 ----
# 逗号分隔的允许跨域前端 Origin；仅白名单内 Origin 才会回显 Access-Control-Allow-Origin。
# 例：http://localhost:5173,http://localhost:5174,https://poster.example.com
# 不配置则回退为回显请求 Origin（本地多 dev 端口联调兼容）；生产环境务必配置。
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
