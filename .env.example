# 知了窝开放平台 —— 代理与 H5 生成器环境变量示例
# 复制为 .env 后填值（.env 已被 .gitignore 忽略，不会入库）
# 单一事实源：所有 app（proxy / admin / h5）共用此根 .env

# ---- 知了窝开放平台鉴权（仅服务端读取，绝不落前端）----
ZLIW_ELAB_APPID=your_elab_appid
ZLIW_PROCELL_APPID=your_procell_appid
# 开放 API 基址（默认 v12，切换版本改此处）
ZLIW_API_BASE=https://open.zhiliaowo.cn/openapi/v12
# 开放组件（iframe）基址（默认 v11）
ZLIW_WIDGET_BASE=https://open.zhiliaowo.cn/v_widget/v11

# ---- 缓存 ----
# memory（默认，零依赖）| redis
CACHE_DRIVER=memory
# 仅 CACHE_DRIVER=redis 时需要
# CACHE_REDIS_URL=redis://127.0.0.1:6379

# ---- 服务监听端口（统一管理，改此处即可换端口）----
# 后端 proxy（Hono）端口
PORT=3000
# HOST=127.0.0.1
# SQLite 数据文件路径（默认 ./data/h5.db）
# H5_DB_PATH=./data/h5.db

# ---- 前端 dev 端口（Vite，统一管理）----
# 管理后台（admin）dev 端口
DEV_PORT_ADMIN=5173
# 展示页（h5）dev 端口
DEV_PORT_H5=5174
# admin 反向代理目标端口（即后端 proxy 端口，需与 PORT 一致）
DEV_PORT_PROXY=3000

# ---- 前端联调（Vite dev，注入 import.meta.env）----
# 后台 / 展示页默认 http://localhost:3000；如代理部署在别的地址可覆盖
# VITE_API_BASE=http://localhost:3000

# 【自由】OpenAI 兼容 API 配置（⚠️ 请勿提交真实 API Key 到此文件）
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://apihub.agnes-ai.com/v1
# AI_MODEL=agnes-2.5-pro
AI_MODEL=agnes-2.5-flash
