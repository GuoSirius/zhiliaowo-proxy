# 知了窝开放 API 基址（默认 v12，切换版本改此处）
ZLIW_API_BASE=https://open.zhiliaowo.cn/openapi/v12

# 各 brand 的 appId —— 找知了窝对接人获取
# brand 标准名（Elabscience / Procell 的精确字符串）也需对接人确认
ZLIW_ELAB_APPID=
ZLIW_PROCELL_APPID=

# 缓存驱动：memory（默认，零依赖）| redis（需下方 CACHE_REDIS_URL）
CACHE_DRIVER=memory
CACHE_REDIS_URL=redis://localhost:6379

# 服务监听端口
PORT=3000
