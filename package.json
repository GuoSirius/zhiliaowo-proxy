{
  "name": "zhiliaowo-monorepo",
  "private": true,
  "version": "3.0.1",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/clean-ports.cjs && pnpm -r --parallel run dev",
    "dev:proxy": "pnpm --filter zhiliaowo-proxy dev",
    "dev:admin": "pnpm --filter @zhiliaowo/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "changelog": "changelogen",
    "release": "node scripts/release.mjs",
    "upgrade": "pnpm up -r --latest --exclude=typescript --exclude=vue-tsc"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "changelogen": "catalog:",
    "husky": "catalog:",
    "node-xlsx": "^0.24.0"
  }
}
